#!/usr/bin/env bpftrace

/*
 * Intel i915 Atomic Commit Tail Tracer
 * 
 * This script traces the intel_atomic_commit_tail function
 * and provides verbose output about the Intel atomic state
 * 
 * Function signature:
 * void intel_atomic_commit_tail(struct intel_atomic_state *state)
 */

BEGIN {
    printf("=== Intel i915 Atomic Commit Tail Tracer ===\n");
    printf("Time: %s\n", strftime("%Y-%m-%d %H:%M:%S", nsecs));
    printf("Tracing: fentry:i915:intel_atomic_commit_tail\n");
    printf("PID: %d\n", pid);
    printf("==========================================\n\n");
    
    @trace_count = 0;
    @start_time = nsecs;
}

fentry:drm_kms_helper:drm_atomic_helper_commit_planes {
    @trace_count++;
    $dev = args->dev;
    $old_state = args->old_state;
    $flags = args->flags;
    
    printf("┌─ TRACE #%d ─────────────────────────────────────────────────────\n", @trace_count);
    printf("│ [%s] drm_atomic_helper_commit_planes() ENTRY\n", strftime("%H:%M:%S.%f", nsecs));
    printf("│ Process: %s (PID: %d, TID: %d)\n", comm, pid, tid);
    printf("│ CPU: %d\n", cpu);
    printf("│\n");
    
    // DRM Device Information
    printf("│ ┌─ DRM Device (struct drm_device *) ──────────────────────────\n");
    printf("│ │ Address: %p\n", $dev);
    
    if ($dev != 0) {
        // Access device fields safely
        printf("│ │ Primary Node: %p\n", $dev->primary);
        printf("│ │ Render Node: %p\n", $dev->render);
        printf("│ │ Driver: %p\n", $dev->driver);
        
        // Try to access driver name if available
        if ($dev->driver != 0) {
            printf("│ │ Driver Name: %s\n", str($dev->driver->name));
        }
        
        // Mode configuration
        printf("│ │ Mode Config Available\n");
        printf("│ │ ├─ Num Connector: %d\n", $dev->mode_config.num_connector);
        printf("│ │ ├─ Num Encoder: %d\n", $dev->mode_config.num_encoder);
        printf("│ │ ├─ Num Crtc: %d\n", $dev->mode_config.num_crtc);
        printf("│ │ └─ Num Plane: %d\n", $dev->mode_config.num_total_plane);
    } else {
        printf("│ │ ERROR: NULL device pointer!\n");
    }
    printf("│ └─────────────────────────────────────────────────────────────\n");
    printf("│\n");
    
    // Atomic State Information
    printf("│ ┌─ Atomic State (struct drm_atomic_state *) ──────────────────\n");
    printf("│ │ Address: %p\n", $old_state);
    printf("│ │ Flags: 0x%x\n", $flags);
    
    if ($old_state != 0) {
        printf("│ │ Device: %p\n", $old_state->dev);
        printf("│ │ Allow Modeset: %s\n", $old_state->allow_modeset ? "true" : "false");
        printf("│ │ Legacy Cursor Update: %s\n", $old_state->legacy_cursor_update ? "true" : "false");
        printf("│ │ Async Update: %s\n", $old_state->async_update ? "true" : "false");
        printf("│ │ Duplicated: %s\n", $old_state->duplicated ? "true" : "false");
        
        // Plane states
        printf("│ │ Planes: %p\n", $old_state->planes);
        if ($old_state->planes != 0) {
            printf("│ │ ├─ Plane States Available\n");
            // Note: Iterating through plane states would require more complex logic
            // For now, just show the pointer
        }
        
        // CRTC states
        printf("│ │ CRTCs: %p\n", $old_state->crtcs);
        if ($old_state->crtcs != 0) {
            printf("│ │ ├─ CRTC States Available\n");
        }
        
        // Connector states
        printf("│ │ Connectors: %p\n", $old_state->connectors);
        if ($old_state->connectors != 0) {
            printf("│ │ ├─ Connector States Available\n");
        }
        
        // Private objects
        printf("│ │ Private Objects: %p\n", $old_state->private_objs);
        if ($old_state->private_objs != 0) {
            printf("│ │ └─ Private Object States Available\n");
        }
    } else {
        printf("│ │ ERROR: NULL atomic state pointer!\n");
    }
    printf("│ └─────────────────────────────────────────────────────────────\n");
    printf("│\n");
    
    // Store entry time for duration calculation
    @entry_time[tid] = nsecs;
}

fexit:drm_kms_helper:drm_atomic_helper_commit_planes {
    $duration_ns = nsecs - @entry_time[tid];
    $duration_us = $duration_ns / 1000;
    
    printf("│ [%s] drm_atomic_helper_commit_planes() EXIT\n", strftime("%H:%M:%S.%f", nsecs));
    printf("│ Duration: %lu ns (%lu μs)\n", $duration_ns, $duration_us);
    printf("└─────────────────────────────────────────────────────────────────\n\n");
    
    // Update statistics
    @total_duration_ns += $duration_ns;
    @min_duration_ns = @min_duration_ns == 0 ? $duration_ns : 
                       ($duration_ns < @min_duration_ns ? $duration_ns : @min_duration_ns);
    @max_duration_ns = $duration_ns > @max_duration_ns ? $duration_ns : @max_duration_ns;
    
    // Clean up
    delete(@entry_time[tid]);
}

// Optional: Track related atomic operations for context
fentry:drm_kms_helper:drm_atomic_helper_commit {
    printf(">>> Related: drm_atomic_helper_commit() called by %s (PID: %d)\n", comm, pid);
}

fentry:drm_kms_helper:drm_atomic_helper_commit_hw_done {
    printf(">>> Related: drm_atomic_helper_commit_hw_done() called by %s (PID: %d)\n", comm, pid);
}

fentry:drm_kms_helper:drm_atomic_helper_commit_cleanup_done {
    printf(">>> Related: drm_atomic_helper_commit_cleanup_done() called by %s (PID: %d)\n", comm, pid);
}

// Handle Ctrl+C gracefully
END {
    printf("\n=== DRM Atomic Helper Commit Planes Tracer Statistics ===\n");
    printf("Script runtime: %lu seconds\n", (nsecs - @start_time) / 1000000000);
    printf("Total traces: %lu\n", @trace_count);
    
    if (@trace_count > 0) {
        printf("Average duration: %lu ns (%lu μs)\n", 
               (uint64)@total_duration_ns / (uint64)@trace_count,
               ((uint64)@total_duration_ns / (uint64)@trace_count) / 1000);
        printf("Min duration: %lu ns (%lu μs)\n", @min_duration_ns, @min_duration_ns / 1000);
        printf("Max duration: %lu ns (%lu μs)\n", @max_duration_ns, @max_duration_ns / 1000);
    }
    
    printf("=========================================================\n");
    
    // Clean up all maps
    clear(@trace_count);
    clear(@start_time);
    clear(@entry_time);
    clear(@total_duration_ns);
    clear(@min_duration_ns);
    clear(@max_duration_ns);
}
